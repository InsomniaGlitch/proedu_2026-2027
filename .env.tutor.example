# Локальные настройки Tutor.
# Скопируйте в .env.tutor и заполните своими значениями.
# Не добавляйте .env.tutor в Git.

# Имя существующего контейнера PostgreSQL.
# Оставьте пустым, если БД доступна по сети без управления контейнером.
TUTOR_DB_CONTAINER=

# Адрес PostgreSQL, доступный из контейнера Langflow.
TUTOR_DB_HOST=YOUR_DB_HOST
TUTOR_DB_PORT=5432
TUTOR_DB_NAME=YOUR_DB_NAME
TUTOR_DB_USER=YOUR_READ_ONLY_USER

# Пароль в Base64. Base64 не является шифрованием.
TUTOR_DB_PASSWORD_B64=YOUR_PASSWORD_BASE64

# Ollama на хосте, доступная из контейнера Langflow.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_TIMEOUT_SECONDS=120

TUTOR_DB_CONNECT_TIMEOUT_SECONDS=10
TUTOR_DB_STATEMENT_TIMEOUT_MS=30000

# При пустом значении скрипт использует имя каталога.
TUTOR_COMPOSE_PROJECT=

# Необязательное имя системного сервиса Ollama.
TUTOR_OLLAMA_SERVICE=

# По умолчанию скрипт не останавливает БД и Ollama.
TUTOR_STOP_DB_ON_STOP=0
TUTOR_STOP_OLLAMA_SERVICE_ON_STOP=0

# Необязательно. Используется как запасное имя сети при остановке.
TUTOR_COMPOSE_NETWORK=
