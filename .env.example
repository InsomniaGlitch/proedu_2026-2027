# =====================================================================
#  Tutor — единый файл настроек
#  Скопируйте в .env и заполните:   cp .env.example .env
#  .env НЕ добавляйте в Git (он уже в .gitignore).
#
#  Этот файл читают сразу три потребителя:
#    1) фронтенд (Next.js)            — раздел «1. Фронтенд»
#    2) docker compose (Langflow)     — раздел «2. Langflow»
#    3) скрипт tutor-local.sh         — раздел «3. Инфраструктура Tutor»
#
#  Формат: только строки KEY=value, без кавычек, export и подстановок.
# =====================================================================


# ---------------------------------------------------------------------
# 1. Фронтенд (Next.js) — как подключиться к Langflow
# ---------------------------------------------------------------------

# Адрес Langflow, доступный с машины, где запущен фронтенд.
# Фронтенд на хосте (npm run dev)      -> http://127.0.0.1:7860
# Фронтенд тоже в Docker               -> http://langflow:7860
LANGFLOW_URL=http://127.0.0.1:7860

# API-ключ Langflow: Langflow -> Settings -> Langflow API Keys -> Create.
# Ключ используется только на сервере Next.js и в браузер не попадает.
LANGFLOW_API_KEY=YOUR_LANGFLOW_API_KEY

# ID потока Tutor. Откройте поток в Langflow — ID стоит в адресной строке:
#   http://127.0.0.1:7860/flow/<ВОТ-ЭТОТ-ID>
# (также можно указать endpoint name потока)
TUTOR_FLOW_ID=YOUR_TUTOR_FLOW_ID

# Формат входных данных:
#   text — обычный чат (поток tutor-flow.json из этой ветки)  [по умолчанию]
#   json — {"action":"ask","telegram_id":...,"run_id":...,"text":...}
#          (формат guarded-flow из ветки main / Telegram-бота)
TUTOR_INPUT_MODE=text

# Сколько ждать ответа Langflow, мс (RAG + модель могут отвечать долго)
TUTOR_REQUEST_TIMEOUT_MS=120000

# 1 — показывать технические детали ошибок в интерфейсе (только для отладки)
TUTOR_DEBUG=0

# Название курса в заголовках и приветствии
NEXT_PUBLIC_COURSE_NAME=Устойчивое развитие: системный подход


# ---------------------------------------------------------------------
# 2. Langflow (docker-compose.yml)
# ---------------------------------------------------------------------

# Пароль суперпользователя Langflow (обязателен для docker compose)
LANGFLOW_SUPERUSER_PASSWORD=YOUR_LOCAL_PASSWORD


# ---------------------------------------------------------------------
# 3. Инфраструктура Tutor (tutor-local.sh, docker-compose.tutor.yml)
#    Переехало сюда из .env.tutor.example без изменений.
# ---------------------------------------------------------------------

# Имя существующего контейнера PostgreSQL.
# Оставьте пустым, если БД доступна по сети без управления контейнером.
TUTOR_DB_CONTAINER=

# Адрес PostgreSQL, доступный из контейнера Langflow.
TUTOR_DB_HOST=YOUR_DB_HOST
TUTOR_DB_PORT=5432
TUTOR_DB_NAME=YOUR_DB_NAME
TUTOR_DB_USER=YOUR_READ_ONLY_USER

# Пароль в Base64 (например: printf '%s' 'мой_пароль' | base64).
# Base64 не является шифрованием — относитесь как к обычному паролю.
TUTOR_DB_PASSWORD_B64=YOUR_PASSWORD_BASE64

# Ollama на хосте, доступная из контейнера Langflow.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_TIMEOUT_SECONDS=120

TUTOR_DB_CONNECT_TIMEOUT_SECONDS=10
TUTOR_DB_STATEMENT_TIMEOUT_MS=30000

# При пустом значении скрипт использует имя каталога.
TUTOR_COMPOSE_PROJECT=

# Необязательное имя системного сервиса Ollama.
TUTOR_OLLAMA_SERVICE=

# По умолчанию скрипт не останавливает БД и Ollama.
TUTOR_STOP_DB_ON_STOP=0
TUTOR_STOP_OLLAMA_SERVICE_ON_STOP=0

# Необязательно. Используется как запасное имя сети при остановке.
TUTOR_COMPOSE_NETWORK=
